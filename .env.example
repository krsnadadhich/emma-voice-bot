# Copy this file to .env and fill in real values. Never commit .env.

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=emma_demo

# --- Local LLM (Ollama) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- Flask ---
PORT=5000

# --- Company profile (folder under profiles/) ---
COMPANY_PROFILE=deliverail
